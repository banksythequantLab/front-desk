[Unit]
Description=Front Desk webhook receiver (Ring) on :8310
After=network-online.target frontdesk-vlm.service
Wants=network-online.target

[Service]
Type=simple
User=banksiai
Group=banksiai
WorkingDirectory=/opt/banksy/front-desk
EnvironmentFile=/opt/banksy/front-desk/.env
ExecStart=/opt/banksy/front-desk/.venv/bin/python -u frontdesk.py
Restart=always
RestartSec=5

StandardOutput=append:/opt/banksy/front-desk/logs/receiver.log
StandardError=append:/opt/banksy/front-desk/logs/receiver.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/banksy/front-desk/data /opt/banksy/front-desk/logs

[Install]
WantedBy=multi-user.target
