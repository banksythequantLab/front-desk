[Unit]
Description=Front Desk MCP server (Alexa+ surface) on :8311
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=banksiai
Group=banksiai
WorkingDirectory=/opt/banksy/front-desk
EnvironmentFile=/opt/banksy/front-desk/.env
ExecStart=/opt/banksy/front-desk/.venv/bin/python -u mcp_server.py
Restart=always
RestartSec=5

StandardOutput=append:/opt/banksy/front-desk/logs/mcp.log
StandardError=append:/opt/banksy/front-desk/logs/mcp.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/banksy/front-desk/data /opt/banksy/front-desk/logs

[Install]
WantedBy=multi-user.target
