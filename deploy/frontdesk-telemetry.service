[Unit]
Description=Front Desk fleet telemetry (CloudWatch, metadata only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=banksiai
Group=banksiai
WorkingDirectory=/opt/banksy/front-desk
EnvironmentFile=/opt/banksy/front-desk/.env
ExecStart=/opt/banksy/front-desk/.venv/bin/python -u telemetry.py
Restart=always
RestartSec=30

StandardOutput=append:/opt/banksy/front-desk/logs/telemetry.log
StandardError=append:/opt/banksy/front-desk/logs/telemetry.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/banksy/front-desk/logs

[Install]
WantedBy=multi-user.target
